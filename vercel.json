{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/play", "destination": "/play.html" },
    { "source": "/docentes", "destination": "/docentes.html" },
    { "source": "/docentes/guia", "destination": "/docentes-guia.html" },
    { "source": "/docentes/consignas", "destination": "/docentes-consignas.html" },
    { "source": "/docentes/ecuaciones", "destination": "/docentes-ecuaciones.html" },
    { "source": "/docentes/plan-clase", "destination": "/docentes-plan-clase.html" },
    { "source": "/docentes/diapositivas", "destination": "/docentes-diapositivas.html" }
  ],
  "headers": [
    {
      "source": "/docentes/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" }
      ]
    }
  ]
}
