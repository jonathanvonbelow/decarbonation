# Variables de entorno para DecarboNation v2.6
# Copiar a .env.local y completar con los valores reales

# Google Gemini API
GEMINI_API_KEY=tu_gemini_api_key_aqui

# Supabase (obtener en supabase.com > Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# NOTA: las variables se leen como process.env.X en el codigo
# (via Vite define en vite.config.ts), NO como import.meta.env
